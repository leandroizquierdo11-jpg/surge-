From 178fea8db59cf0db33f5752f16d47037be331acb Mon Sep 17 00:00:00 2001
From: leandroizquierdo11-jpg <336344874+leandroizquierdo11-jpg@users.noreply.github.com>
Date: Sun, 4 Oct 2026 07:13:52 +0000
Subject: [PATCH 3/3] Webtoon: lay out pages further ahead of the viewport

---
 .../tachiyomi/ui/reader/viewer/webtoon/WebtoonViewer.kt     | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webtoon/WebtoonViewer.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webtoon/WebtoonViewer.kt
index 33d21d1..23bf5c3 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webtoon/WebtoonViewer.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webtoon/WebtoonViewer.kt
@@ -53,9 +53,11 @@ class WebtoonViewer(val activity: ReaderActivity, val isContinuous: Boolean = tr
     private val scrollDistance = activity.resources.displayMetrics.heightPixels * 3 / 4
 
     /**
-     * Layout manager of the recycler view.
+     * Layout manager of the recycler view. Pages are laid out (and so decoded) up to two screens ahead
+     * in the scroll direction, so the next page is usually ready before it becomes visible. This matters
+     * on tablets, where a page scaled to the screen width can be several screens tall.
      */
-    private val layoutManager = WebtoonLayoutManager(activity, scrollDistance)
+    private val layoutManager = WebtoonLayoutManager(activity, activity.resources.displayMetrics.heightPixels * 2)
 
     /**
      * Configuration used by this viewer, like allow taps, or crop image borders.
-- 
