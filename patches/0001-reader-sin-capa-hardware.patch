From 6b501b5e371186d17fe95508ab8a2ade1261202c Mon Sep 17 00:00:00 2001
From: leandroizquierdo11-jpg <336344874+leandroizquierdo11-jpg@users.noreply.github.com>
Date: Sun, 4 Oct 2026 06:58:43 +0000
Subject: [PATCH 1/3] Reader: only use a hardware layer when a color filter is
 active

---
 .../java/eu/kanade/tachiyomi/ui/reader/ReaderActivity.kt    | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/ReaderActivity.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/ReaderActivity.kt
index 351e5ca..0567f12 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/ReaderActivity.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/ReaderActivity.kt
@@ -17,6 +17,7 @@ import android.view.KeyEvent
 import android.view.MotionEvent
 import android.view.View
 import android.view.View.LAYER_TYPE_HARDWARE
+import android.view.View.LAYER_TYPE_NONE
 import android.view.WindowManager
 import android.widget.Toast
 import androidx.activity.enableEdgeToEdge
@@ -984,7 +985,10 @@ class ReaderActivity : BaseActivity() {
         }
         private fun setLayerPaint(grayscale: Boolean, invertedColors: Boolean) {
             val paint = if (grayscale || invertedColors) getCombinedPaint(grayscale, invertedColors) else null
-            binding.viewerContainer.setLayerType(LAYER_TYPE_HARDWARE, paint)
+            // Only use an offscreen layer when a color filter is needed. An always-on hardware layer
+            // forces the whole reader to be re-rendered offscreen on every scroll frame, which causes
+            // stutter on large/high resolution screens such as tablets.
+            binding.viewerContainer.setLayerType(if (paint != null) LAYER_TYPE_HARDWARE else LAYER_TYPE_NONE, paint)
         }
     }
 }
